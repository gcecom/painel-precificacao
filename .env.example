# Variáveis do Assistente IA — configurar SÓ na Vercel (Project → Settings → Environment Variables).
# NUNCA colocar a chave no frontend nem commitar o valor real.

# Obrigatória: chave da OpenAI (fica só no servidor /api/chat).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: modelo usado pela Responses API (padrão: gpt-5.6-terra).
OPENAI_MODEL=gpt-5.6-terra

# Opcionais: só se quiser sobrescrever os padrões públicos (já embutidos, pois são públicos por design).
# SUPABASE_URL=https://novcfkmcliquuvmnqwoe.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
